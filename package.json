{
  "name": "dsh-plugin-crafter",
  "version": "0.1.0",
  "description": "Develop DeepSeek Harness plugins across reusable isolated environments with official-source guidance and artifact verification",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "skills/dsh-plugin-crafter/SKILL.md",
    "skills/dsh-upstream-source/SKILL.md",
    "skills/dsh-plugin-verification/SKILL.md",
    "skills/dsh-plugin-verification/references/environment-registry.md",
    "skills/dsh-plugin-verification/references/host-checks.md",
    "skills/dsh-plugin-verification/scripts/environments.py",
    "docs/compatibility.md",
    "README.md",
    "LICENSE",
    "examples/README.md",
    "examples/greeting-tool/README.md",
    "examples/greeting-tool/cordis.patch.yml",
    "examples/greeting-tool/greeting.js",
    "examples/greeting-tool/index.js",
    "examples/greeting-tool/package.json",
    "examples/greeting-tool/test/greeting.test.js",
    "examples/host-status/README.md",
    "examples/host-status/cordis.patch.yml",
    "examples/host-status/index.js",
    "examples/host-status/index.test.mjs",
    "examples/host-status/package.json",
    "examples/release-checklist/README.md",
    "examples/release-checklist/cordis.patch.yml",
    "examples/release-checklist/package.json",
    "examples/release-checklist/skills/release-checklist/SKILL.md",
    "scripts/smoke-examples.mjs",
    "docs/examples-verification.md",
    "README.zh.md",
    "README.i18n.yaml",
    "docs/isolated-development.md",
    "docs/isolated-development.zh.md",
    "docs/examples-verification.zh.md",
    "docs/development.zh.md",
    "docs/compatibility.zh.md",
    "docs/development.md",
    "examples/README.zh.md",
    "examples/greeting-tool/README.zh.md",
    "examples/host-status/README.zh.md",
    "examples/release-checklist/README.zh.md",
    "docs/isolated-development.i18n.yaml",
    "docs/examples-verification.i18n.yaml",
    "docs/compatibility.i18n.yaml",
    "docs/development.i18n.yaml",
    "examples/README.i18n.yaml",
    "examples/greeting-tool/README.i18n.yaml",
    "examples/host-status/README.i18n.yaml",
    "examples/release-checklist/README.i18n.yaml",
    "docs/verification.json"
  ],
  "scripts": {
    "check": "node --test scripts/*.test.mjs examples/greeting-tool/test/*.test.js examples/host-status/*.test.mjs",
    "check:upstream": "node scripts/sync-official-preset.mjs --check",
    "pack:check": "npm pack --dry-run --json",
    "smoke:examples": "node scripts/smoke-examples.mjs",
    "check:docs": "node --test scripts/check-docs.test.mjs",
    "doc-sync": "node scripts/check-docs.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "gosomea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gosomea/dsh-plugin-crafter.git"
  },
  "homepage": "https://github.com/gosomea/dsh-plugin-crafter#readme",
  "bugs": {
    "url": "https://github.com/gosomea/dsh-plugin-crafter/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin-development",
    "agent-preset",
    "skills"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "markdown-it": "15.0.2",
    "yaml": "2.9.1"
  }
}
